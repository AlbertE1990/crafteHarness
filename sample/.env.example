# DeepSeek 模型连接。复制到 .env.local 后填写真实密钥。
DEEPSEEK_API_KEY=replace-me
DEEPSEEK_BASE_URL=https://api.deepseek.com
# 模型名必填：库不再内置会过期的默认模型名。
DEEPSEEK_MODEL=deepseek-v4-flash

# 推理等级。供应商会不断调整等级集合，因此这里就是唯一配置点：
# 改模型或增删等级只需要改这个文件并重启，不需要改库或前端代码。
# DEEPSEEK_REASONING_EFFORT 是部署默认等级；off 表示关闭推理；留空表示不下发该参数。
DEEPSEEK_REASONING_EFFORT=high
# 前端下拉候选，逗号分隔；留空表示由用户自由输入。它不限制请求，只影响候选与启动校验。
DEEPSEEK_REASONING_EFFORTS=off,low,high,max

# CraftAgent 本地 PostgreSQL。不要把真实密码提交到仓库。
CRAFT_AGENT_DATABASE_URL=postgresql://postgres:replace-me@127.0.0.1:5432/craft_agent_dev
CRAFT_AGENT_DATABASE_POOL_MAX=10
CRAFT_AGENT_DATABASE_SSL=false
