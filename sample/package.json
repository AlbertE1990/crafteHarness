{
  "name": "craft-harness-sample",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build:harness": "pnpm --filter craft-harness build",
    "predev": "pnpm build:harness",
    "dev": "concurrently -n server,web -c green,cyan \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "node --import tsx --watch src/server/index.ts",
    "dev:web": "vite --open",
    "start:server": "node dist-server/index.js",
    "build": "pnpm build:harness && pnpm build:server && pnpm build:web",
    "build:server": "tsup --config tsup.server.config.ts",
    "build:web": "vite build",
    "preview": "vite preview",
    "pretest": "pnpm build:harness",
    "test": "vitest run --config vite.config.ts",
    "pretest:watch": "pnpm build:harness",
    "test:watch": "vitest --config vite.config.ts",
    "pretypecheck": "pnpm build:harness",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "db:check": "tsx src/server/database/check.ts",
    "db:migrate": "tsx src/server/database/migrate.ts",
    "predb:test-store": "pnpm build:harness",
    "db:test-store": "tsx test/mysql-session-store.contract.ts"
  },
  "dependencies": {
    "@fastify/static": "catalog:",
    "@vueuse/core": "catalog:frontend",
    "craft-harness": "workspace:*",
    "fastify": "catalog:",
    "markdown-it": "catalog:",
    "mysql2": "catalog:",
    "vue": "catalog:frontend",
    "vue-router": "catalog:frontend",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@antfu/eslint-config": "catalog:dev",
    "@iconify-json/carbon": "catalog:build",
    "@types/node": "catalog:dev",
    "@unocss/eslint-plugin": "catalog:dev",
    "@vitejs/plugin-vue": "catalog:build",
    "@vue-macros/volar": "catalog:dev",
    "@vue/test-utils": "catalog:dev",
    "concurrently": "catalog:",
    "eslint": "catalog:dev",
    "eslint-plugin-format": "catalog:dev",
    "jsdom": "catalog:build",
    "tsup": "catalog:build",
    "tsx": "catalog:",
    "typescript": "catalog:dev",
    "unocss": "catalog:build",
    "unplugin-auto-import": "catalog:build",
    "unplugin-vue-components": "catalog:build",
    "unplugin-vue-macros": "catalog:build",
    "vite": "catalog:build",
    "vitest": "catalog:dev",
    "vue-tsc": "catalog:dev"
  }
}
