# DeepSeek 模型连接。复制到 .env.local 后填写真实密钥。
DEEPSEEK_API_KEY=replace-me
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash

# CraftAgent 本地 PostgreSQL。不要把真实密码提交到仓库。
CRAFT_AGENT_DATABASE_URL=postgresql://postgres:replace-me@127.0.0.1:5432/craft_agent_dev
CRAFT_AGENT_DATABASE_POOL_MAX=10
CRAFT_AGENT_DATABASE_SSL=false
