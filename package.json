{
  "name": "craft-harness",
  "type": "module",
  "version": "0.1.1",
  "packageManager": "pnpm@10.30.3",
  "description": "A deterministic, provider-neutral agent harness for Node.js: agent loop, tool harness, append-only session log and model adapters.",
  "author": {
    "name": "Wangxiaoxiang",
    "url": "https://github.com/AlbertE1990"
  },
  "license": "MIT",
  "homepage": "https://github.com/AlbertE1990/crafteHarness",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AlbertE1990/crafteHarness.git"
  },
  "bugs": {
    "url": "https://github.com/AlbertE1990/crafteHarness/issues"
  },
  "keywords": [
    "agent",
    "agent-loop",
    "harness",
    "llm",
    "tool-calling",
    "function-calling",
    "openai",
    "deepseek",
    "nodejs",
    "typescript"
  ],
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./adapters": {
      "types": "./dist/adapters/index.d.ts",
      "import": "./dist/adapters/index.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "typecheck:public-api": "tsc --noEmit --strict --skipLibCheck --target ES2021 --lib ESNext,DOM --module ESNext --moduleResolution bundler --types node,vitest/globals test/public-api.test.ts",
    "lint": "eslint .",
    "smoke:pack": "node scripts/smoke-pack.mjs",
    "release:check": "pnpm lint && pnpm typecheck && pnpm typecheck:public-api && pnpm test && pnpm build && pnpm smoke:pack",
    "prepublishOnly": "pnpm release:check",
    "hooks:install": "simple-git-hooks",
    "up": "taze major -I"
  },
  "dependencies": {
    "@vscode/ripgrep": "catalog:",
    "openai": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@antfu/eslint-config": "catalog:dev",
    "@types/node": "catalog:dev",
    "eslint": "catalog:dev",
    "eslint-plugin-format": "catalog:dev",
    "lint-staged": "catalog:dev",
    "simple-git-hooks": "catalog:dev",
    "taze": "catalog:dev",
    "tsup": "catalog:build",
    "typescript": "catalog:dev",
    "vitest": "catalog:dev"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm lint-staged"
  },
  "lint-staged": {
    "*": "eslint --fix"
  }
}
